# Conexão com o PostgreSQL
DATABASE_URL=postgresql://ecommflow:TROQUE_A_SENHA@localhost:5432/ecommflow

# Segredo para assinar a sessão (gere com: openssl rand -base64 48)
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Segredo do cron diário (gera tarefas e marca atrasadas). Gere com: openssl rand -hex 24
CRON_SECRET=troque-este-segredo

# Fuso horário do banco/aplicação
TZ=America/Sao_Paulo
PORT=3000
